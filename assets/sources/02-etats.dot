digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="02 · Demo states\nOFF/AUTO = user choice · availability and alarm are separate dimensions"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
start [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Startup</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">OFF · setpoint 25 °C</FONT></TD></TR></TABLE>>, fillcolor="#fff4da"];
off [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">OFF</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Fan demand: 0 %</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
auto [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">AUTO available</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Compute from reading and setpoint</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
lost [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">AUTO degraded</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Reading invalid or 1 s old</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Request 0 % in the simulation</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
alarm [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Overheating: independent alarm</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">True above 50 °C with a valid reading</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">On loss: retain value, mark quality unavailable</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
start -> off [label="", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
off -> auto [label="Select AUTO with an available reading", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
off -> lost [label="Select AUTO without an available reading", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
auto -> off [label="Select OFF", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=false];
lost -> off [label="Select OFF", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=false];
auto -> lost [label="Loss / invalidity / expiry", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
lost -> auto [label="New valid reading", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=false];
auto -> alarm [label="Monitoring", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=false];
lost -> alarm [label="Degraded quality", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
}

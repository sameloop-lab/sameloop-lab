digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="08 · Zephyr: software zbus and explicit external link\nShown variant: local MCU control · all connections remain to be developed"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
host [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">sameloop-gateway</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Linux: UI and supervision</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
subgraph cluster_mcu { label="Microcontroller · proposed sameloop-zephyr"; fontcolor="#b42318"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
bridge [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Gateway task</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Encode / decode / validate / limit</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
bus [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">zbus — SOFTWARE BUS</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Messages in firmware memory</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">No CAN or I²C wires inside this block</FONT></TD></TR></TABLE>>, fillcolor="#efeafb"];
sensor [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Acquisition task</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Sensor driver → reading</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
ctrl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Control task</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Sole owner of commands</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
fan [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Actuator task</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Command → driver; speed feedback</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
bridge -> bus [label="zbus messages", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
bus -> sensor [label="temperature channel", color="#257d70", fontcolor="#257d70", style="dashed", dir="back", constraint=true];
bus -> ctrl [label="Reading, setpoint\nState, command", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
bus -> fan [label="fan_command\nfan_feedback", color="#346fa8", fontcolor="#346fa8", style="dashed", dir="both", constraint=true];
{rank=same; sensor; ctrl; fan;}
}
thermo [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Physical sensor</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Example: I²C thermometer</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
motor [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Physical fan</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">PWM command + tachometer feedback</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
host -> bridge [label="CHOOSE A PHYSICAL LINK\nUART/USB serial, CAN or IP/Ethernet/Wi-Fi\nGateway protocol required", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
sensor -> thermo [label="I²C or SPI through a driver", color="#668444", fontcolor="#668444", style="dashed", dir="back", constraint=true];
fan -> motor [label="PWM through interface / tachometer", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
}

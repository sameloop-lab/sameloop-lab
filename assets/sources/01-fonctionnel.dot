digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="01 · A box, a thermometer and a fan\nFunctional view · no technical background required"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
u [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">A person</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Chooses the desired temperature</FONT></TD></TR></TABLE>>, fillcolor="#fff4da"];
screen [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Display</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Shows reading, setpoint and alarms</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
ctrl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Decide</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Compare the reading with the setpoint</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
fan [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Ventilate</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Increase or decrease airflow</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
box [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">The box</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Its temperature changes</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
sensor [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Measure</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">The thermometer provides a reading</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
alarm [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Monitor</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Missing reading or excessive temperature</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
u -> screen [label="Select OFF / AUTO and a setpoint", color="#346fa8", fontcolor="#346fa8", style="solid", dir="forward", constraint=true];
screen -> ctrl [label="Settings request", color="#346fa8", fontcolor="#346fa8", style="solid", dir="forward", constraint=true];
ctrl -> fan [label="Fan command", color="#346fa8", fontcolor="#346fa8", style="solid", dir="forward", constraint=true];
fan -> box [label="Cooling airflow", color="#668444", fontcolor="#668444", style="solid", dir="forward", constraint=true];
box -> sensor [label="Actual temperature", color="#668444", fontcolor="#668444", style="solid", dir="forward", constraint=true];
sensor -> ctrl [label="New reading", color="#257d70", fontcolor="#257d70", style="solid", dir="forward", constraint=false];
sensor -> alarm [label="Value and quality", color="#257d70", fontcolor="#257d70", style="solid", dir="forward", constraint=true];
alarm -> screen [label="Reading / state / alarm", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=false];
fan -> screen [label="Observed speed", color="#257d70", fontcolor="#257d70", style="solid", dir="forward", constraint=false];
{rank=same; ctrl; alarm;}
}

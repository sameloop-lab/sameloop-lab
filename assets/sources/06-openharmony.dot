digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="06 · OpenHarmony: IPC services and external UI\nProposed architecture · same device for the first prototype"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
ui [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Flutter / LVGL on a PC</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Native port not assumed</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
subgraph cluster_oh { label="OpenHarmony standard device · version and SDK to select"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
gateway [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">sameloop-openharmony</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Network facade to develop</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
bus [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Local Binder IPC</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Proxy / stub and services</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Distinct from the AFB binder</FONT></TD></TR></TABLE>>, fillcolor="#efeafb"];
ctrl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Controller service</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Settings, control, alarms</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
prov [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Provider services</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Simulated temperature and fan</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
gateway -> bus [label="IPC calls / callbacks", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
bus -> ctrl [label="Calls / events", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
ctrl -> prov [label="Local IPC", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
}
ui -> gateway [label="Proposed HTTP or WebSocket\nTLS/mTLS to validate at the facade", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
optional [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Remote RPC / DSoftBus</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Unconfirmed option: conflicting</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a"> documentation; version-specific test required</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
bus -> optional [label="Separate investigation", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
}

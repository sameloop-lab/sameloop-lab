digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="13 · From repositories to reproducible demos\nProposed workflow · build systems remain specific to each target"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
git [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Repositories and pinned versions</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Code + contract + dependencies + licenses</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
build [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Native build</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Meson / Flutter / CMake / Cargo / SDK</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Selected per component, no single tool</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
rpm [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">RPM / spec / OBS</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Linux packages to develop</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
yocto [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Yocto recipes / layers</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">AGL or Linux target images to develop</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
native [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Platform SDK / west</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">OpenHarmony, webOS or Zephyr firmware</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
test [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Install, then test the profile</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Same scenario using the deliverable</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
lab [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">sameloop-lab</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Release archive and presentation</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Versions, evidence, limitations and fallback</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
git -> build [label="Identified sources", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
build -> rpm [label="Package path", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
git -> yocto [label="Image and recipe path", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
git -> native [label="Target-specific path", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
rpm -> test [label="Artifact + configuration", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
yocto -> test [label="Artifact + configuration", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
native -> test [label="Artifact + configuration", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
test -> lab [label="Results and checksums", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
{rank=same; rpm; yocto; native;}
}

digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="14 · Connect two stacks with a single controller\nProposed first step: AFB → KUKSA telemetry only"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
owner [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">AFB: control loop owner</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Existing controller and fan</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
bridge [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">sameloop-bridge</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Converts types, units and quality</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Preserves origin and freshness</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
kuksa [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">KUKSA: initially an observer</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Replicated read-only signals</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
view [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Display / comparison tool</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Observes the same state</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
future [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Later phase: requests</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Forward to the sole owner</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">No second active controller</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
owner -> bridge [label="WSJ1 telemetry", color="#257d70", fontcolor="#257d70", style="dashed", dir="forward", constraint=true];
bridge -> kuksa [label="gRPC publishing", color="#257d70", fontcolor="#257d70", style="dashed", dir="forward", constraint=true];
kuksa -> view [label="Read / subscribe", color="#257d70", fontcolor="#257d70", style="dashed", dir="forward", constraint=true];
view -> future [label="Optional setpoint request", color="#346fa8", fontcolor="#346fa8", style="dashed", dir="forward", constraint=true];
future -> owner [label="Contract and permissions to define", color="#346fa8", fontcolor="#346fa8", style="dashed", dir="forward", constraint=false];
}

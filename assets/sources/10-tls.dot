digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="10 · Plaintext, server-authenticated TLS and mTLS\nSecurity concepts · no SameLoop TLS profile tested yet"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
subgraph cluster_clear { label="A · Local plaintext"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
clearc [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Local client</FONT></B></TD></TR></TABLE>>, fillcolor="#edf3fa"];
clears [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Local service</FONT></B></TD></TR></TABLE>>, fillcolor="#edf3fa"];
clearc -> clears [label="HTTP or WS over TCP loopback\nNo TLS encryption", color="#42637e", fontcolor="#42637e", style="solid", dir="both", constraint=true];
}
subgraph cluster_tls { label="B · TLS with a server certificate"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
tlsc [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Client: verifies the server</FONT></B></TD></TR></TABLE>>, fillcolor="#edf3fa"];
tlss [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Server: presents its certificate</FONT></B></TD></TR></TABLE>>, fillcolor="#edf3fa"];
tlsc -> tlss [label="HTTPS / WSS / gRPC over TLS\nServer identity verified", color="#42637e", fontcolor="#42637e", style="solid", dir="both", constraint=true];
}
subgraph cluster_mtls { label="C · mTLS"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
mtlsc [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Client: presents its certificate</FONT></B></TD></TR></TABLE>>, fillcolor="#edf3fa"];
mtlss [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Server: presents its certificate</FONT></B></TD></TR></TABLE>>, fillcolor="#edf3fa"];
mtlsc -> mtlss [label="HTTPS / WSS / gRPC over TLS\nBoth identities verified", color="#42637e", fontcolor="#42637e", style="solid", dir="both", constraint=true];
}
auth [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">After authentication: authorization</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Reader ≠ operator ≠ controller</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">TLS 1.2 / 1.3 are versions, not these two modes</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
tlss -> auth [label="Application policy", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
mtlss -> auth [label="Application policy", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
}

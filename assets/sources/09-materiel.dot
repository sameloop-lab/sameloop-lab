digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="09 · From messages to wires: three alternative links\nConceptual diagram · pinout, transceivers, power and drivers require validation"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
linux [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Linux host</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Application + provider adapter</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
uart [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Host serial interface</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Logic-level UART / USB-UART adapter</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
can [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Host CAN interface</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">SocketCAN → controller + transceiver</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
net [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Host network interface</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Ethernet or Wi-Fi + IP stack</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
mcu [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Zephyr microcontroller</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Drivers + gateway task + zbus</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">STM32 / ESP32 / nRF depending on profile</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
sensor [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Temperature sensor</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Local peripheral</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
fan [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Fan and interface</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Electrical control and feedback</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
linux -> uart [label="Framed bytes", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
linux -> can [label="Frames / mapping", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
linux -> net [label="Selected network protocol", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
uart -> mcu [label="TX/RX and electrical reference\nCompatible voltage levels", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
can -> mcu [label="CAN bus + MCU-side transceiver\nTermination according to topology", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
net -> mcu [label="Ethernet / radio\nCompatible hardware required", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
mcu -> sensor [label="I²C / SPI / other selected driver", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
mcu -> fan [label="PWM → command\nTachometer → reading", color="#668444", fontcolor="#668444", style="dashed", dir="both", constraint=true];
{rank=same; uart; can; net;}
{rank=same; sensor; fan;}
}

digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="11 · CommonAPI / SOME/IP: comparison extension\nProposed architecture · optional stack beyond the MVP"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
ui [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">UI or test client</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">C++/FFI bridge or facade to select</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
subgraph cluster_app { label="Proposed sameloop-commonapi"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
proxy [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Generated CommonAPI proxy</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Application interface / IDL</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
runtime [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">SOME/IP runtime: vsomeip</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Transport, routing, discovery</FONT></TD></TR></TABLE>>, fillcolor="#efeafb"];
stub [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">CommonAPI stub + service</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Settings and events</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
ctrl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Controller and providers</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Same thermal behavior</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
proxy -> runtime [label="CommonAPI SOME/IP binding", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
runtime -> stub [label="SOME/IP over TCP/UDP\nSOME/IP-SD depending on configuration", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
stub -> ctrl [label="Local calls", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
}
ui -> proxy [label="Adapter to develop", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
sec [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Network protection</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Native TLS over SOME/IP not assumed</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Separate validation</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
runtime -> sec [label="Option under investigation", color="#42637e", fontcolor="#42637e", style="dashed", dir="forward", constraint=true];
}

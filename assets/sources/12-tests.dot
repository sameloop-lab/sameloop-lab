digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="12 · Every test level has a scope\nPassing unit tests does not validate the network, UI or hardware"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
unit [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">L1 · Isolated component</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Model, bounds, conversion</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
contract [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">L2 · Adapter</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Messages, timeouts, errors and mocks</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
real [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">L3 · Connected real services</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Calls, events, failures and recovery</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
ui [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">L4 · End to end</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">UI action → service → displayed feedback</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
hardware [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">L5 · Hardware</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Firmware, buses, wiring and peripherals</FONT></TD></TR></TABLE>>, fillcolor="#edf7f0"];
package [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">L6 · Installed deliverable</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Package/image in a clean environment</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
proof [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Report per profile and revision</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Expected · observed · logs · limitations</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Update components AND connections</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
unit -> contract [label="Extend coverage", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
contract -> real [label="Replace mocks where needed", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
real -> ui [label="Add the real UI", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
real -> hardware [label="Add the real target", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
ui -> package [label="Rerun after installation", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
hardware -> package [label="For hardware profiles", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
package -> proof [label="Archive evidence", color="#42637e", fontcolor="#42637e", style="solid", dir="forward", constraint=true];
}

digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.58", splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="07 · webOS OSE: services on Luna Bus\nProposed architecture · OSE target; commercial TV support not assumed"];
node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#a6b6c8", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.13"];
edge [fontname="DejaVu Sans", fontsize=11, color="#42637e", fontcolor="#36536b", arrowsize=0.7, penwidth=1.3];
ui [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Flutter / LVGL on a PC</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">External network client</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
subgraph cluster_webos { label="webOS OSE device · image and SDK to pin"; fontsize=14; style="rounded"; color="#c6d4e1"; bgcolor="#fafcfe";
gateway [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">sameloop-webos</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Network facade to develop</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
bus [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">LS2 / Luna Bus</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Local software IPC bus</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Methods, subscriptions, permissions</FONT></TD></TR></TABLE>>, fillcolor="#efeafb"];
ctrl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Controller service</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Setpoint, control and alarms</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
prov [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#b42318">Sensor / fan services</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Simulation, then optional drivers</FONT></TD></TR></TABLE>>, fillcolor="#edf3fa"];
gateway -> bus [label="luna:// calls and subscriptions", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
bus -> ctrl [label="LS2", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
ctrl -> prov [label="LS2", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
}
ui -> gateway [label="Proposed HTTP or WebSocket\nTLS/mTLS: termination to define", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
native [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B><FONT COLOR="#17324d">Native webOS UI</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">Possible local variant through the SDK</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#42566a">To validate separately</FONT></TD></TR></TABLE>>, fillcolor="#fff8e9"];
native -> bus [label="LS2 access", color="#42637e", fontcolor="#42637e", style="dashed", dir="both", constraint=true];
}
